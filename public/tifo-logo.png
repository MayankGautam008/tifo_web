<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 300" width="300" height="300">
  <!-- Background circle -->
  <circle cx="150" cy="150" r="145" fill="#F5F0E8"/>
  <circle cx="150" cy="150" r="140" fill="none" stroke="#C1440E" stroke-width="6"/>

  <!-- "tifo" text -->
  <text x="85" y="185" font-family="Georgia, 'Times New Roman', serif" font-size="100" font-weight="900" fill="#C1440E" letter-spacing="-3">tif</text>

  <!-- 'o' with mortar and pestle icon incorporated -->
  <circle cx="237" cy="165" r="38" fill="#C1440E"/>
  <!-- Mortar bowl shape -->
  <path d="M220 175 Q237 195 254 175" fill="#F5F0E8" stroke="#F5F0E8" stroke-width="2"/>
  <!-- Pestle -->
  <line x1="250" y1="148" x2="240" y2="170" stroke="#F5F0E8" stroke-width="5" stroke-linecap="round"/>
  <!-- Leaves -->
  <ellipse cx="235" cy="135" rx="10" ry="16" fill="#C1440E" transform="rotate(-30 235 135)"/>
  <ellipse cx="248" cy="130" rx="9" ry="14" fill="#C1440E" transform="rotate(15 248 130)"/>
  <line x1="237" y1="145" x2="237" y2="127" stroke="#F5F0E8" stroke-width="2"/>

  <!-- Tagline -->
  <text x="150" y="232" font-family="Georgia, serif" font-size="14" fill="#444" text-anchor="middle" letter-spacing="0.5">the right food, right person, right time</text>
</svg>
